# Copy to .env to change what compose.yaml uses. Everything has a default.

# The name people type, and the address the UI uses to reach the API. Caddy gets
# a certificate for this name; for localhost it makes a local one.
NETPROBE_DOMAIN=localhost
NETPROBE_PUBLIC_URL=https://localhost

# Where Grafana is. It needs a name of its own, so that nothing it runs shares
# the origin of the UI; *.localhost points at this machine in the browsers.
NETPROBE_GRAFANA_DOMAIN=grafana.localhost
NETPROBE_GRAFANA_URL=https://grafana.localhost

# Ports of the host. Caddy needs 80 and 443 to get a certificate for a real name.
NETPROBE_HTTP_PORT=80
NETPROBE_HTTPS_PORT=443

# The address they listen on. 127.0.0.1 keeps the proxy off the network, which is
# what a Cloudflare Tunnel (docker compose --profile cloudflared) asks for.
NETPROBE_BIND=0.0.0.0

# How long results are kept: 2160h is 90 days, 0 keeps them for ever.
NETPROBE_RETENTION=2160h

# The version of the images, a release such as 1.0.0, or latest.
NETPROBE_VERSION=latest
