      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netprobe"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.name AS \"Edge\", count(*) AS \"Incidents\"\nFROM incidents i JOIN edges e ON e.id = i.edge_id\nWHERE $__timeFilter(i.started_at)\nGROUP BY 1 ORDER BY 2 DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
