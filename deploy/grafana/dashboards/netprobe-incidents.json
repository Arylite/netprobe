        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "top",
        "minVizHeight": 16,
        "minVizWidth": 8
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Incidents",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netprobe"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netprobe"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN i.resolved_at IS NULL THEN 'Open' ELSE 'Resolved' END AS \"State\",\n       CASE i.kind WHEN 'check' THEN i.check_id ELSE 'edge went quiet' END AS \"What\",\n       e.name AS \"Edge\",\n       i.started_at AS \"Started\",\n       extract(epoch FROM coalesce(i.resolved_at, now()) - i.started_at) AS \"Duration\",\n       i.resolution AS \"Ended\",\n       i.detail AS \"Detail\"\nFROM incidents i JOIN edges e ON e.id = i.edge_id\nWHERE $__timeFilter(i.started_at)\nORDER BY i.started_at DESC LIMIT 500",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "index": 0
                      },
                      "Failing": {
                        "color": "red",
                        "index": 1
                      },
                      "No recent run": {
                        "color": "orange",
                        "index": 2
                      },
                      "Open": {
                        "color": "red",
                        "index": 3
                      },
                      "Resolved": {
                        "color": "green",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Response"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Success 24 h"
            },
            "properties": [
              {
                "id": "unit",
