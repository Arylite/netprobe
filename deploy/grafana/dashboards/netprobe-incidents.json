    {
      "id": 5,
      "type": "timeseries",
      "title": "Incidents started",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netprobe"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netprobe"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(started_at, '1h'),\n       CASE kind WHEN 'check' THEN 'a check keeps failing' ELSE 'an edge went quiet' END AS metric,\n       count(*) AS value\nFROM incidents\nWHERE $__timeFilter(started_at)\nGROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": 900000,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Which checks",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netprobe"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netprobe"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN kind = 'check' THEN check_id ELSE 'an edge went quiet' END AS \"Subject\", count(*) AS \"Incidents\"\nFROM incidents WHERE $__timeFilter(started_at)\nGROUP BY 1 ORDER BY 2 DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "top",
        "minVizHeight": 16,
        "minVizWidth": 8
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Which edges",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netprobe"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 8
