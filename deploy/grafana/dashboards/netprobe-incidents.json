          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(extract(epoch FROM resolved_at - started_at)) AS \"MTTR\" FROM incidents WHERE $__timeFilter(started_at) AND resolved_at IS NOT NULL",
