    {
      "id": 7,
      "type": "timeseries",
      "title": "Response time by edge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netprobe"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netprobe"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(r.at, $__interval),\n       e.name AS metric,\n       avg(r.rtt_millis) AS value\nFROM results r JOIN edges e ON e.id = r.edge_id\nWHERE $__timeFilter(r.at) AND r.ok AND r.check_id = '$check' AND r.edge_id = ANY(ARRAY[$edge]::text[])\nGROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 900000,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
