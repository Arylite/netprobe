          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(at, $__interval),\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY rtt_millis) AS \"p50\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY rtt_millis) AS \"p95\",\n       percentile_cont(0.99) WITHIN GROUP (ORDER BY rtt_millis) AS \"p99\",\n       max(rtt_millis) AS \"slowest\"\nFROM results\nWHERE $__timeFilter(at) AND ok AND check_id = '$check' AND edge_id = ANY(ARRAY[$edge]::text[])\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 900000,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
