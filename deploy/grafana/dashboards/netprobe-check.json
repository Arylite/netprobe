      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netprobe"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(CASE WHEN ok THEN 1.0 ELSE 0.0 END) AS \"Success rate\" FROM results WHERE $__timeFilter(at) AND check_id = '$check' AND edge_id = ANY(ARRAY[$edge]::text[])",
          "refId": "A"
