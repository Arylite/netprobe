          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT at AS time, rtt_millis AS \"Response\"\nFROM results\nWHERE $__timeFilter(at) AND ok AND check_id = '$check' AND edge_id = ANY(ARRAY[$edge]::text[])\nORDER BY at\nLIMIT 200000",
          "refId": "A"
