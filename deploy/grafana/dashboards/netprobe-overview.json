      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netprobe"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(r.at, $__interval),\n       r.check_id || ' @ ' || e.name AS metric,\n       avg(r.rtt_millis) AS value\nFROM results r JOIN edges e ON e.id = r.edge_id\nWHERE $__timeFilter(r.at) AND r.ok AND r.check_id = ANY(ARRAY[$check]::text[]) AND r.edge_id = ANY(ARRAY[$edge]::text[])\nGROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
