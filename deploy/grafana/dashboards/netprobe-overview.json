    {
      "id": 11,
      "type": "table",
      "title": "Where every check stands",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netprobe"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netprobe"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (check_id, edge_id) check_id, edge_id, at, ok, rtt_millis, error\n  FROM results\n  WHERE at > now() - interval '24 hours'\n  ORDER BY check_id, edge_id, at DESC\n), day AS (\n  SELECT check_id, edge_id,\n         avg(CASE WHEN ok THEN 1.0 ELSE 0.0 END) AS success,\n         percentile_cont(0.95) WITHIN GROUP (ORDER BY rtt_millis) FILTER (WHERE ok) AS p95\n  FROM results\n  WHERE at > now() - interval '24 hours'\n  GROUP BY check_id, edge_id\n)\nSELECT l.check_id AS \"Check\",\n       e.name AS \"Edge\",\n       CASE WHEN l.at < now() - interval '5 minutes' THEN 'No recent run' WHEN l.ok THEN 'OK' ELSE 'Failing' END AS \"State\",\n       l.at AS \"Last run\",\n       l.rtt_millis AS \"Response\",\n       d.success AS \"Success 24 h\",\n       d.p95 AS \"p95\",\n       l.error AS \"Error\"\nFROM latest l\nJOIN day d USING (check_id, edge_id)\nJOIN edges e ON e.id = l.edge_id\nWHERE e.revoked_at IS NULL\nORDER BY l.ok, l.check_id, e.name",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
