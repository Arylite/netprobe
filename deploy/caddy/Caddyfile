{
	servers {
		# Only cloudflared, when it is used, is believed about who the client is.
		trusted_proxies static 172.28.0.11
	}
}

(netprobe) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# What edges call: open to every address that has a token.
	@edge path /healthz /v1/*
	handle @edge {
		request_body {
			max_size 2MB
		}
		reverse_proxy central:8080
	}

	# What the UI calls, and the UI: only the addresses of NETPROBE_UI_ALLOW.
	handle /api/* {
		@denied not client_ip {$NETPROBE_UI_ALLOW:0.0.0.0/0 ::/0}
		respond @denied 404
		request_body {
			max_size 2MB
		}
		reverse_proxy central:8081
	}

	handle {
		@denied not client_ip {$NETPROBE_UI_ALLOW:0.0.0.0/0 ::/0}
		respond @denied 404
		reverse_proxy web:8080
	}
}

{$NETPROBE_DOMAIN:localhost} {
	import netprobe
}

# Grafana, on a name of its own, for the same addresses as the UI.
(grafana) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@denied not client_ip {$NETPROBE_UI_ALLOW:0.0.0.0/0 ::/0}
	respond @denied 404

	reverse_proxy grafana:3000
}

{$NETPROBE_GRAFANA_DOMAIN:grafana.localhost} {
	import grafana
}

# For cloudflared, inside the compose network only: Cloudflare holds the certificate.
http://:8088 {
	import netprobe
}

http://:8089 {
	import grafana
}
